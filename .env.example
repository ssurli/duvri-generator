# =============================================
# ESEMPIO DI CONFIGURAZIONE VARIABILI D'AMBIENTE
# =============================================
# Copia questo file in ".env" e compila i valori reali.
# Il file ".env" NON deve essere committato (è già in .gitignore).
#
# In sviluppo locale queste variabili vengono caricate automaticamente
# da load_environment() all'avvio (python app.py).
# In produzione su PythonAnywhere impostale invece nel file WSGI
# (vedi pythonanywhere_wsgi.py) perché il file WSGI non carica il .env.

# --- Sicurezza applicazione ---
SECRET_KEY=cambia_con_una_chiave_segreta
FLASK_ENV=development

# --- Credenziali area amministratore ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_password

# =============================================
# NOTIFICA EMAIL "SALVA DATI APPALTATORE"
# =============================================
# Indirizzo email aziendale che riceve la notifica quando un appaltatore
# salva i propri dati dal form.
NOTIFICA_EMAIL=tua-email-aziendale@esempio.it

# Configurazione server SMTP usato per l'invio.
# Esempio Gmail (richiede una "app password", non la password normale):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=iltuoaccount@gmail.com
#   SMTP_PASSWORD=la_tua_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=iltuoaccount@gmail.com
SMTP_PASSWORD=la_tua_app_password

# Mittente mostrato nell'email (opzionale, default = SMTP_USER)
SMTP_FROM=iltuoaccount@gmail.com
